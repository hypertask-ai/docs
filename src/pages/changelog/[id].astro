---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import ChangelogLayout from '../../layouts/ChangelogLayout.astro';
import { formatDate } from '../../lib/changelog';

export async function getStaticPaths() {
  return (await getCollection('changelog')).map((entry) => ({
    params: { id: entry.id }, props: { entry },
  }));
}
interface Props { entry: CollectionEntry<'changelog'> }
const { entry } = Astro.props;
const { Content } = await render(entry);
---

<ChangelogLayout title={entry.data.title} description={entry.data.summary}>
  <article class="changelog-entry">
    <a class="changelog-back" href="/changelog/">← Back to all</a>
    <div class="changelog-meta">
      <time datetime={entry.data.date.toISOString().slice(0, 10)}>{formatDate(entry.data.date)}</time>
      <ul class="changelog-tags" aria-label="Areas">
        {entry.data.tags.map((tag) => <li>{tag}</li>)}
      </ul>
    </div>
    <div class="changelog-body"><Content /></div>
  </article>
</ChangelogLayout>
