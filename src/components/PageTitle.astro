---
import Default from '@astrojs/starlight/components/PageTitle.astro';
import AIActions from './AIActions.astro';

const sidebar = Astro.locals.starlightRoute.sidebar;
type SidebarEntry = (typeof sidebar)[number];
const containsCurrent = (entry: SidebarEntry): boolean =>
	entry.type === 'link' ? entry.isCurrent : entry.entries.some(containsCurrent);
const group = sidebar.find((entry) => entry.type === 'group' && entry.entries.some(containsCurrent));
---

<AIActions />
{group && <div class="page-kicker">{group.label}</div>}
<Default><slot /></Default>

<style>
	.page-kicker {
		color: #d97757;
		font-size: 12px;
		font-weight: 500;
		letter-spacing: .08em;
		text-transform: uppercase;
		line-height: 16px;
		margin-bottom: 12px;
	}
</style>

<style is:global>
	.ai-actions {
		justify-content: flex-end;
		margin: 0 0 0.5rem !important;
	}
</style>
