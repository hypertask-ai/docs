[Unit]
Description=Refresh generated Hypertask docs references

[Service]
Type=oneshot
# The script runs from the ops checkout; it still reads, builds and pushes
# only the dedicated automation clone, never a developer checkout.
Environment=DOCS_REFS_REPO=%h/.local/state/docs-refs/repo
ExecStart=/bin/bash %h/projects/hypertask-docs-ops/scripts/docs-refresh.sh
Environment=PATH=%h/.local/bin:%h/.npm-global/bin:/usr/local/bin:/usr/bin:/bin
StandardOutput=journal
StandardError=journal
SyslogLevelPrefix=yes
TimeoutStartSec=45min
